# syntax=docker/dockerfile:1.7

FROM cgr.dev/chainguard/node:latest-dev AS builder
WORKDIR /home/nonroot/app

COPY package*.json ./
RUN npm ci --no-audit --omit=optional

COPY . .

# Optional base path for deployments behind a subpath.
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

# Supabase credentials — leave empty for local-only mode.
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_PUBLISHABLE_KEY=
ARG VITE_SUPABASE_SECRET_KEY=
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_PUBLISHABLE_KEY=${VITE_SUPABASE_PUBLISHABLE_KEY}
ENV VITE_SUPABASE_SECRET_KEY=${VITE_SUPABASE_SECRET_KEY}

# Allow local-only (no login) mode in Docker.
ARG VITE_ALLOW_LOCAL_ONLY=true
ENV VITE_ALLOW_LOCAL_ONLY=${VITE_ALLOW_LOCAL_ONLY}

RUN npm run build:web

FROM node:22-alpine AS runtime

WORKDIR /app

# Ensure data directory exists and has correct permissions
RUN mkdir -p /app/data && chown -R node:node /app

COPY --from=builder /home/nonroot/app/dist ./dist
COPY server ./server

USER node

EXPOSE 8080

CMD ["node", "server/index.mjs"]
