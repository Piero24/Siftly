# syntax=docker/dockerfile:1.7

FROM cgr.dev/chainguard/node:latest-dev AS builder
WORKDIR /home/nonroot/app

COPY package*.json ./
RUN npm ci --no-audit --omit=optional

COPY . .

# Optional base path for deployments behind a subpath.
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

# Supabase credentials — leave empty for local-only mode.
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}

# Allow local-only (no login) mode in Docker.
ARG VITE_ALLOW_LOCAL_ONLY=true
ENV VITE_ALLOW_LOCAL_ONLY=${VITE_ALLOW_LOCAL_ONLY}

RUN npm run build:web

FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime

COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /home/nonroot/app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
