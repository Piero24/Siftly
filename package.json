{
  "name": "siftly",
  "version": "1.0.2",
  "main": "index.js",
  "scripts": {
    "dev": "VITE_BUILD_TARGET=extension vite",
    "dev:web": "VITE_BUILD_TARGET=web vite",
    "metadata:sync": "node scripts/sync-metadata.mjs",
    "metadata:verify": "node scripts/sync-metadata.mjs --check",
    "build": "VITE_BUILD_TARGET=extension vite build",
    "build:extension": "VITE_BUILD_TARGET=extension vite build",
    "build:web": "VITE_BUILD_TARGET=web vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"documentation/**/*.{md,ts,tsx,js,jsx,json,yml,yaml,css}\" \".github/workflows/*.{yml,yaml}\" \"src/**/*.test.{ts,tsx}\" \"src/test/**/*.{ts,tsx}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"documentation/**/*.{md,ts,tsx,js,jsx,json,yml,yaml,css}\" \".github/workflows/*.{yml,yaml}\" \"src/**/*.test.{ts,tsx}\" \"src/test/**/*.{ts,tsx}\" \"*.{json,md,yml,yaml}\"",
    "docs:dev": "npm --prefix documentation run start",
    "docs:build": "npm --prefix documentation run build",
    "docs:serve": "npm --prefix documentation run serve",
    "release:prepare": "npm run metadata:sync && npm run format"
  },
  "keywords": [],
  "author": "",
  "license": "Prosperity-3.0.0",
  "description": "Your job search control panel",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.38",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@everapi/freecurrencyapi-js": "^1.0.1",
    "@supabase/supabase-js": "^2.100.1",
    "country-state-city": "^3.2.1",
    "flag-icons": "^7.5.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.577.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "react-simple-maps": "^3.0.0",
    "react-tooltip": "^5.30.0",
    "recharts": "^3.8.0"
  },
  "overrides": {
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.5"
  }
}
